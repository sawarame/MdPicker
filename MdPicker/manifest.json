{
  "manifest_version": 3,
  "name": "MdPicker",
  "version": "1.0",
  "description": "Copy links as Markdown format directly from context menu.",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
